@model Practical6.Models.Product

@{
    ViewBag.Title = "Product Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Product Details</title>
</head>
<body>
    <h2>Product Details</h2>

    @if (Model != null)
    {
        <p><strong>Product Id:</strong> @Model.ProductId</p>
        <p><strong>Product Name:</strong> @Model.ProductName</p>
        <p><strong>Product Description:</strong> @Model.Description</p>
        <p><strong>Price:</strong> @Model.Price</p>
        <p><strong>Category:</strong> @Model.Category</p>
    }
    else
    {
        <p>Product not found.</p>
    }

    <br />
    @Html.ActionLink("Back to Product Catalog", "Index", "Product")
</body>
</html>
